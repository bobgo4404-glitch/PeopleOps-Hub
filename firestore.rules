rules_version = '2';

// PeopleOps Hub(1인 사용): 소유자 계정 하나만 모든 데이터를 읽고 쓴다.
// 소유자는 appMeta/owner 문서의 ownerUid. 문서가 없을 때만 최초 로그인 계정이 소유자로 등록된다.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerPath() {
      return /databases/$(database)/documents/artifacts/peopleops-hub/public/data/appMeta/owner;
    }

    function isOwner() {
      return request.auth != null
        && exists(ownerPath())
        && get(ownerPath()).data.ownerUid == request.auth.uid;
    }

    match /artifacts/peopleops-hub/public/data/appMeta/owner {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && !exists(ownerPath())
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /artifacts/peopleops-hub/public/data/{collectionId}/{documentId} {
      allow read, write: if isOwner() && !(collectionId == "appMeta" && documentId == "owner");
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
